{
  "name": "camping-planner-server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "imports": {
    "#config": "./src/config/config.js",
    "#prisma/*": "./src/prisma/*",
    "#repositories": "./src/repositories/index.js",
    "#constants": "./src/common/constants/index.js",
    "#exceptions": "./src/common/exceptions/index.js",
    "#schemas": "./src/common/schemas/index.js",
    "#mappers": "./src/common/mappers/index.js",
    "#di": "./src/common/di/container.js",
    "#controllers": "./src/controllers/index.js",
    "#services": "./src/services/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#providers": "./src/providers/index.js",
    "#interface": "./src/interface/index.js",
    "#common/interfaces": "./src/common/interfaces/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown src/main.ts",
    "dev": "tsx watch --env-file=./env/.env.development src/main.ts",
    "start": "node --env-file=./env/.env.development dist/main.mjs",
    "prisma:emit": "dotenv -e ./env/.env.development -- prisma contract emit",
    "prisma:init": "dotenv -e ./env/.env.development -- prisma db init",
    "campsites:sync": "tsx --env-file=./env/.env.development src/scripts/sync-campsites.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.21.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "awilix": "^13.0.7",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "prettier": "^3.10.1",
    "prisma": "8.0.0-rc.34",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
