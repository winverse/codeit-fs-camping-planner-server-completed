{
  "name": "camping-planner-server",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/main.js",
  "type": "module",
  "imports": {
    "#config": {
      "production": "./dist/config/config.js",
      "default": "./src/config/config.js"
    },
    "#prisma/*": {
      "production": "./dist/prisma/*",
      "default": "./src/prisma/*"
    },
    "#repositories": {
      "production": "./dist/repositories/index.js",
      "default": "./src/repositories/index.js"
    },
    "#constants": {
      "production": "./dist/common/constants/index.js",
      "default": "./src/common/constants/index.js"
    },
    "#exceptions": {
      "production": "./dist/common/exceptions/index.js",
      "default": "./src/common/exceptions/index.js"
    },
    "#schemas": {
      "production": "./dist/common/schemas/index.js",
      "default": "./src/common/schemas/index.js"
    },
    "#mappers": {
      "production": "./dist/common/mappers/index.js",
      "default": "./src/common/mappers/index.js"
    },
    "#controllers": {
      "production": "./dist/controllers/index.js",
      "default": "./src/controllers/index.js"
    },
    "#services": {
      "production": "./dist/services/index.js",
      "default": "./src/services/index.js"
    },
    "#middlewares": {
      "production": "./dist/middlewares/index.js",
      "default": "./src/middlewares/index.js"
    },
    "#providers": {
      "production": "./dist/providers/index.js",
      "default": "./src/providers/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=./env/.env.development src/main.ts",
    "start": "node --conditions=production --env-file=./env/.env.development dist/main.js",
    "prisma:emit": "dotenv -e ./env/.env.development -- prisma contract emit",
    "prisma:init": "dotenv -e ./env/.env.development -- prisma db init",
    "campsites:sync": "tsx --env-file=./env/.env.development src/scripts/sync-campsites.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "awilix": "^13.0.5",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "prettier": "^3.9.10",
    "prisma": "8.0.0-rc.27",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
